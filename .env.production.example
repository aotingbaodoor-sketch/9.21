CRM_HOST=crm.example.com
APP_ORIGIN=https://crm.example.com
POSTGRES_PASSWORD=replace_with_64_character_random_hex
# 以下密码需与 POSTGRES_PASSWORD 一致。若含特殊字符，请进行 URL 编码。
DATABASE_URL=postgresql://autinberg:replace_with_64_character_random_hex@db:5432/autinberg

# WhatsApp机密只注入服务端。详细设置及旧号码注意事项见docs/WHATSAPP.md。
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ENCRYPTION_KEY=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_SIGNUP_CONFIG_ID=
