{
  "name": "autinberg-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:crm",
    "build": "npm run build:crm",
    "build:crm": "npm run typecheck && vite build && tsc -p tsconfig.server.json && node scripts/copy-migrations.mjs",
    "dev:crm": "concurrently -k -n api,web \"node --env-file-if-exists=.env --import tsx --watch server/index.ts\" \"vite\"",
    "start:crm": "node --env-file-if-exists=.env build/server/index.js",
    "test:quoting": "node --import tsx --test tests/quoting.test.ts && node --import tsx tests/quoting.integration.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "oxlint --deny-warnings src server shared scripts tests",
    "start": "npm run start:crm",
    "db:setup": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:local": "node --import tsx scripts/local-db.ts",
    "admin:init": "node --env-file-if-exists=.env --import tsx scripts/create-admin.ts",
    "db:backup": "node --env-file-if-exists=.env --import tsx scripts/backup.ts backup",
    "db:restore": "node --env-file-if-exists=.env --import tsx scripts/backup.ts restore",
    "test": "node --import tsx --test tests/domain.test.ts",
    "test:integration": "node --import tsx tests/integration.ts",
    "whatsapp:bind": "node --env-file-if-exists=.env --import tsx scripts/whatsapp-bind.ts",
    "test:whatsapp": "node --import tsx tests/whatsapp.integration.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "libphonenumber-js": "^1.13.13",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
