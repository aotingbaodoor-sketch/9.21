  "sequences": [
    {
      "id": "seq_customer_same_partner_same_day",
      "kind": "sequence",
      "description": "同一合伙人同一天开发 3 个新客户 → 001 / 002 / 003",
      "why": "最基本的序号推进",
      "steps": [
        {
          "op": "make_customer_code",
          "args": [
            "A001",
            "2026-09-22",
            1
          ],
          "expect": "A001260922001"
        },
        {
          "op": "make_customer_code",
          "args": [
            "A001",
            "2026-09-22",
            2
          ],
          "expect": "A001260922002"
        },
        {
          "op": "make_customer_code",
          "args": [
            "A001",
            "2026-09-22",
            3
          ],
          "expect": "A001260922003"
        }
      ]
    },
    {
      "id": "seq_customer_different_partner_same_day",
      "kind": "sequence",
      "description": "不同合伙人同一天各自从 001 起",
      "why": "★ 客户序号按「合伙人 × 日」分组，**不是**全公司当日流水",
      "steps": [
        {
          "op": "make_customer_code",
          "args": [
            "A001",
            "2026-09-22",
            1
          ],
          "expect": "A001260922001"
        },
        {
          "op": "make_customer_code",
          "args": [
            "A002",
            "2026-09-22",
            1
          ],
          "expect": "A002260922001"
        },
        {
          "op": "make_customer_code",
          "args": [
            "A003",
            "2026-09-22",
            1
          ],
          "expect": "A003260922001"
        },
        {
          "op": "make_customer_code",
          "args": [
            "A001",
            "2026-09-22",
            2
          ],
          "expect": "A001260922002"
        }
      ]
    },
    {
      "id": "seq_customer_next_day_reset",
      "kind": "sequence",
      "description": "次日序号重置为 001",
      "why": "日期段参与编号 ⇒ 跨日自然重置；不需要任何\"每日清零\"的定时任务",
      "steps": [
        {
          "op": "make_customer_code",
          "args": [
            "A001",
            "2026-09-22",
            5
          ],
          "expect": "A001260922005"
        },
        {
          "op": "make_customer_code",
          "args": [
            "A001",
            "2026-09-23",
            1
          ],
          "expect": "A001260923001"
        },
        {
          "op": "make_customer_code",
          "args": [
            "A001",
            "2026-09-23",
            2
          ],
          "expect": "A001260923002"
        }
      ]
    },
    {
      "id": "seq_customer_month_boundary",
      "kind": "sequence",
      "description": "跨月边界：09-30 → 10-01",
      "why": "避免实现方用 30 天/31 天的近似算法",
      "steps": [
        {
          "op": "make_customer_code",
          "args": [
            "A001",
            "2026-09-30",
            9
          ],
          "expect": "A001260930009"
        },
        {
          "op": "make_customer_code",
          "args": [
            "A001",
            "2026-10-01",
            1
          ],
          "expect": "A001261001001"
        }
      ]
    },
    {
      "id": "seq_customer_year_boundary",
      "kind": "sequence",
      "description": "跨年边界：2026-12-31 → 2027-01-01",
      "why": "★ 序号重置，但**批次字母不变** —— 批次按「入职年份」，不按「业务年份」",
      "steps": [
        {
          "op": "make_customer_code",
          "args": [
            "A001",
            "2026-12-31",
            9
          ],
          "expect": "A001261231009"
        },
        {
          "op": "make_customer_code",
          "args": [
            "A001",
            "2027-01-01",
            1
          ],
          "expect": "A001270101001"
        }
      ]
    },
    {
      "id": "seq_customer_old_customer_followup_does_not_consume",
      "kind": "sequence",
      "description": "★ 同日先跟进老客户、再开发新客户 —— 新客户仍拿 001",
      "why": "当日序号**只数新客户**。老客户跟进不占号 —— 由 CRM 层保证：跟进老客户时**沿用原编号、不调用发号函数**。这是最容易实现错的一条。",
      "steps": [
        {
          "op": "make_customer_code",
          "args": [
            "A001",
            "2026-09-23",
            1
          ],
          "expect": "A001260923001",
          "comment": "当天第 1 个【新】客户"
