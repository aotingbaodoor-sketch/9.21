# 只在服务端读取；不得添加 VITE_ 前缀。
DATABASE_URL=postgresql://autinberg:replace_with_private_password@127.0.0.1:5432/autinberg
APP_ORIGIN=http://127.0.0.1:5173
HOST=127.0.0.1
PORT=3001
SESSION_HOURS=12
# 初始化时临时设置 ADMIN_EMAIL、ADMIN_NAME、ADMIN_PASSWORD，完成后立即清除。

# 可选官方WhatsApp集成：无配置时CRM其他功能仍可用；不要添加VITE_前缀。
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# 32字节随机密钥的64位hex；单独离线备份，重部署不可重新生成。
WHATSAPP_ENCRYPTION_KEY=
# 在Meta控制台选择受支持的Graph版本，例如v数字.数字（没有隐式版本）。
WHATSAPP_GRAPH_VERSION=
WHATSAPP_SIGNUP_CONFIG_ID=
# 现有Cloud API号码安全绑定示例；Token值只在服务器secret store/.env。
# WHATSAPP_TOKEN_SALES_A=
# WHATSAPP_BIND_EMAIL=
# WHATSAPP_BIND_WABA_ID=
# WHATSAPP_BIND_PHONE_ID=
# WHATSAPP_BIND_TOKEN_ENV=WHATSAPP_TOKEN_SALES_A
# WHATSAPP_BIND_CONFIRMED=EXISTING_CLOUD_API_ONLY
